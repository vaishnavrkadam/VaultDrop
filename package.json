{
  "name": "vaultdrop-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w services/api",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w services/api",
    "test": "npm test --workspaces"
  }
}
